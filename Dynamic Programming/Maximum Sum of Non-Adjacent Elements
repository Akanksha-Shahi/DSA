// SPACE OPTIMIZATION
int maxNon(vector<int>& nums){
    int n = nnums.size();
    int prev = nums[0];
    int prev2=0;
    for( int i =1; i<n; i++){
        int take = nums[i];
        if( i>1) take+=prev2;
        int nottake = 0+ prev;
        int curr = max(take, nottake);
        prev2= prev;
        prev = curr;
