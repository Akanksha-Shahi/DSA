#include <bits/stdc++.h>
using namespace std;
// Intro to DP - Fibonacci Number [ MEMOIZATION ]
int f ( int n, vector<int> &dp){
    if(n<=1) return n;
    if(dp[n] != -1) return dp[n];
    return dp[n]=f(n-1, dp)+f(n-2, dp);
}

// Intro to DP - Fibonacci Number [ TABULATION ]
int f ( int n){
    vector<int> dp(n+1, -1);
    dp[0]=0;
    dp[1]=1;
    for( int i=2; i<=n; i++){
        dp[i]=dp[i-1]+dp[i-2];
    }
    return dp[n];
}
int main(){
    int n ;
    cin>>n;
    int prev2 =0, prev =1;
    for(int i =2; i<=n; i++){
        int curr = prev +prev2;
        prev2= prev;
        prev = curr;
    }
    cout<< prev;
    return 0;
}
