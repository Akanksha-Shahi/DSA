int maxNon(vector<int>& nums){
    int n = nnums.size();
    int prev = nums[0];
    int prev2=0;
    for( int i =1; i<n; i++){
        int take = nums[i];
        if( i>1) take+=prev2;
        int nottake = 0+ prev;
        int curr = max(take, nottake);
        prev2= prev;
        prev = curr;
    }
    return prev;
} 
long long int houseRobber(vector<int> & val){

    vector<int> temp1, temp2;
    int n = val.size();
    if( n==1) return val[0];
    for( int i =0; i<n; i++){
        if( i!=0) temp1.push_back(val[i]);
        if( i!=n-1) temp2.push_back(val[i]);
    }
    return max(maxNonAdj(temp1), maxNonAdj(temp2));
}
