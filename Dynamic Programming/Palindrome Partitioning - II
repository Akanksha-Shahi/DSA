//Palindrome Partitioning - II
// memoization
bool isPalindrome( const string& s, int start, int end){
    while(start<end){
        if(s[start]!=s[end]) return false;
        start++;
        end--;
    }
    return true;
}
int minCuts(const string& s, int start, vector<int>& memo){
    int n = (int)s.size();
    if( start == n || isPalindrome(s, start, n-1)) return 0;
    if(memo[start]!=-1) return memo[start];
    int minCuts = INT_MAX;
    for( int end = start; end<n; end++){
        if(isPalindrome(s, start, end)){
            int cuts = 1+ minCuts(s, end+1, memo);
            minCuts = min(minCuts, cuts);
        }
    }
    return memo[start] = minCuts;
}
int minCut(const string& s){
    int n = (int)s.size();
    vector<int> memo(n, -1);
    return minCuts(s, 0, memo);
}
// tabulation
bool isPalindrome( const string& s, int i, int j){
    while(i< j){
        if(s[i]!=s[j]) return false;
        i++;
        j--;
    }
    return true;
}
int minCut(string s){
    int n =(int)s.size();
    vector<int> dp(n+1,0);
    dp[n]=-1;
    for( int i =n-1; i>=0; i--) {
        int minCuts = INT_MAX;
        for( int j =i; j<n; j++){
            if(isPalindrome(s, i, j)){
                int cuts = 1+ dp[j+1];
                minCuts = min(minCuts, 1+dp[j+1]);
            }
        }
        dp[i]= minCuts;
    }
    return dp[0];
}
