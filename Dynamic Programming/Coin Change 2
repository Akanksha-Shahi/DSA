// Coin Change 2
// memoization
long countways(vector<int>& arr, int ind, int T, vector<vector<long>>& dp){
    if( ind ==0) return ( T% arr[0]==0);
    if(dp[ind][T] != -1) return dp[ind][T];
    long notTaken = countWays(arr, ind-1, T, dp);
    long taken =0;
    if(arr[ind]<=T) taken = countWays(arr, ind, T-arr[ind], dp);
    return dp[ind][T]= notTaken + taken;
} 
long countwaystochange(vector<int>&arr, int n, int T){
    vector<vector<long>> dp(n, vector<long>(T+1, -1));
    return countWays(arr, n-1, T, dp);
}
// tabulation
long countwaysto Change(vector<int>& arr, int n , int T){
    vector<vector<long>> dp(n, vector<long>(T+1, 0));
    for( int i =0; i<=T; i++){
        if( i% arr[0]==0) dp[0][i]=1;
    }
    for( int i =1; i<n; i++){
        for( int t =0; t<=T; t++){
            long notTaken = dp[i-1][t];
            long taken =0;
            if(arr[i]<=t) taken = dp[i][t-arr[i]];
            dp[i][t]= notTaken + taken;
        }
    }
    return dp[n-1][T];
}
// space optimization
long countwaystoChange(vector<int>& arr, int n , int T){
    vector<long> prev(T+1, 0), curr(T+1, 0);
    for( int i =0; i<=T; i++){
        if( i% arr[0]==0) prev[i]=1;
    }
    for( int i =1; i<n; i++){
        for( int t =0; t<=T; t++){
            long notTaken = prev[t];
            long taken =0;
            if(arr[i]<=t) taken = curr[t-arr[i]];
            curr[t]= notTaken + taken;
        }
        prev = curr;
    }
    return prev[T];
}
