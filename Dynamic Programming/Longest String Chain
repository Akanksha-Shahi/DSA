// Longest String Chain
int longestString(vector<string>& words){
    int n = words.size();
    sort(words.begin(); words.end(), compare);
    vector<int> dp(n,1);
    int maxlen =0;
    for( int i =0; i<n; i++){
        for ( int j =0; j<i; j++){
            if(checkPossible(words[i], words[j]) && dp[i]< dp[j]+1) dp[i]= dp[j]+1;
        }
        if( dp[i]>maxlen) maxlen = dp[i];
    }
    return maxlen;
}
